<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Data Protection keychain group for the Games DB play-history credential (blompie_mac):
	     readable only by Blompie signed by the team, with no per-build keychain prompts. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)net.digitalnoise.Blompie</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.jkoch.blompie</string>
	</array>
</dict>
</plist>
